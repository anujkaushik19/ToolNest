# Meta / Instagram Graph API — Creator Studio connection
# Create an app at https://developers.facebook.com/apps (type: Business).
# Add the "Instagram Graph API" and "Facebook Login" products.
# The connecting Instagram account must be a Business or Creator account
# linked to a Facebook Page (personal accounts cannot read insights).
#
# In Dev Mode you can connect ~25 test accounts without App Review.
# Copy this file to .env.local and fill in the values (never commit .env.local).

META_APP_ID=
META_APP_SECRET=
# Must exactly match a Valid OAuth Redirect URI configured in the app dashboard.
META_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# --- Data foundation (optional) ------------------------------------------------
# All three are OPTIONAL. Without them the app runs exactly as before: the Meta
# token lives in an httpOnly cookie and there's no history/persistence. Set them
# to enable encrypted server-side token storage + the daily snapshot cron.

# Postgres connection string (Neon / Supabase / any Postgres). When set, tokens
# are stored encrypted in the DB and the browser only holds an opaque id.
DATABASE_URL=

# 32-byte secret used to encrypt Meta tokens at rest (AES-256-GCM).
# Generate one with:  openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Shared secret protecting /api/cron/snapshot. Vercel Cron sends it as a Bearer
# token automatically when this env var is set on the project.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=
